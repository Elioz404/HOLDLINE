# Copy to .env and fill in. .env is gitignored.
# Key is server-only. Never ship it to a browser.
CALLE_API_KEY=

# The number the day-1 traversal probe will dial. E.164, no spaces, no extension.
# Use a line you own or are authorized to call.
HOLDLINE_PROBE_NUMBER=

# Optional label written into call metadata so runs can be correlated later.
HOLDLINE_PROBE_LABEL=day1-traversal
